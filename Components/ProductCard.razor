<div class="col">
    <div class="card shadow-sm h-100">
        @if (!string.IsNullOrEmpty(Product?.ImagePath))
        {
            <img src="@Product?.ImagePath" class="card-img-top" alt="@Product?.Name" style="height: 225px; object-fit: cover;">
        }
        else
        {
            <svg aria-label="Placeholder: Thumbnail" class="bd-placeholder-img card-img-top" height="225" preserveAspectRatio="xMidYMid slice" role="img" width="100%" xmlns="http://www.w3.org/2000/svg">
                <title>@(Product?.Name ?? "Продукт")</title>
                <rect width="100%" height="100%" fill="#55595c"></rect>
                <text x="50%" y="50%" fill="#eceeef" dy=".3em" text-anchor="middle">@(Product?.Name ?? "Продукт")</text>
            </svg>
        }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Product?.Name</h5>
            <p class="card-text flex-grow-1">@(Product?.Description ?? "Нет описания")</p>
            @if (!string.IsNullOrEmpty(Price))
            {
                <h6 class="text-primary">@Price</h6>
            }
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnAddToCart" disabled="@isAdding">
                        @if (isAdding)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Добавить в корзину
                    </button>
                </div>
                @if (ShowDetails)
                {
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="OnViewDetails">
                        Подробнее
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product? Product { get; set; }

    [Parameter]
    public string? Price { get; set; }

    [Parameter]
    public bool ShowDetails { get; set; } = false;

    [Inject]
    private ICartService? CartService { get; set; }

    [Inject]
    private IJSRuntime? JS { get; set; }

    [Inject]
    private NavigationManager? Navigation { get; set; }

    private bool isAdding = false;

    private async Task OnAddToCart()
    {
        if (Product != null && CartService != null && JS != null)
        {
            try
            {
                isAdding = true;
                StateHasChanged();

                // Add to cart
                await CartService.AddToCartAsync(Product.Id, 1);

                // Show success notification
                await ShowNotification($"{Product.Name} добавлен в корзину", "success");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error adding to cart: {ex.Message}");
                await ShowNotification("Ошибка при добавлении товара", "error");
            }
            finally
            {
                isAdding = false;
                StateHasChanged();
            }
        }
    }

    private async Task OnViewDetails()
    {
        if (Navigation != null && Product != null)
        {
            Navigation.NavigateTo($"/product/{Product.Id}");
        }
        else
        {
            Console.WriteLine("Product view is not implemented yet");
        }
    }

    private async Task ShowNotification(string message, string type)
    {
        if (JS != null)
        {
            await JS.InvokeVoidAsync("showNotification", message, type);
        }
    }
}
