@page "/cart"
@using ksoproject.Models
@inject ICartService CartService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Корзина</PageTitle>

<div class="container mt-4">
    <h2>Корзина</h2>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (cartItems == null || !cartItems.Any())
    {
        <div class="alert alert-info">
            Ваша корзина пуста. <a href="/shop">Перейти к покупкам</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Товар</th>
                                        <th>Цена</th>
                                        <th>Количество</th>
                                        <th>Сумма</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cartItems)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td>@item.Price.ToString("C")</td>
                                            <td>
                                                <div class="input-group input-group-sm" style="width: 120px;">
                                                    <button class="btn btn-outline-secondary"
                                                            @onclick="() => UpdateQuantity(item.ProductId, item.Quantity - 1)">
                                                        -
                                                    </button>
                                                    <input type="number" class="form-control text-center"
                                                           @bind="item.Quantity" @bind:event="oninput"
                                                           @onchange="() => UpdateQuantity(item.ProductId, item.Quantity)" />
                                                    <button class="btn btn-outline-secondary"
                                                            @onclick="() => UpdateQuantity(item.ProductId, item.Quantity + 1)">
                                                        +
                                                    </button>
                                                </div>
                                            </td>
                                            <td>@((item.Price * item.Quantity).ToString("C"))</td>
                                            <td>
                                                <button class="btn btn-danger btn-sm"
                                                        @onclick="() => RemoveItem(item.ProductId)">
                                                    🗑️
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end">Итого:</td>
                                        <td colspan="2">@totalAmount.ToString("C")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5>Итого к оплате</h5>
                        <h3 class="text-primary">@totalAmount.ToString("C")</h3>
                        <hr />
                        <button class="btn btn-success w-100" @onclick="GoToCheckout">
                            Оформить заказ
                        </button>
                        <button class="btn btn-outline-secondary w-100 mt-2" @onclick="ClearCart">
                            Очистить корзину
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CartItem>? cartItems;
    private decimal totalAmount;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCart();
    }

    private async Task LoadCart()
    {
        try
        {
            isLoading = true;
            cartItems = await CartService.GetCartItemsAsync();
            totalAmount = await CartService.GetCartTotalAsync();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateQuantity(int productId, int quantity)
    {
        if (quantity < 0) return;
        await CartService.UpdateQuantityAsync(productId, quantity);
        await LoadCart();
        await ShowNotification("Количество обновлено", "info");
    }

    private async Task RemoveItem(int productId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Удалить товар из корзины?"))
        {
            await CartService.RemoveFromCartAsync(productId);
            await LoadCart();
            await ShowNotification("Товар удален из корзины", "success");
        }
    }

    private async Task ClearCart()
    {
        if (await JS.InvokeAsync<bool>("confirm", "Очистить всю корзину?"))
        {
            await CartService.ClearCartAsync();
            await LoadCart();
            await ShowNotification("Корзина очищена", "success");
        }
    }

    private void GoToCheckout()
    {
        Navigation.NavigateTo("/checkout");
    }

    private async Task ShowNotification(string message, string type)
    {
        await JS.InvokeVoidAsync("showNotification", message, type);
    }
}
