@page "/"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ksoproject.Models
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Главная - Магазин КСП</PageTitle>

<div class="container">
    @if (LoadedAds == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка предложений...</p>
        </div>
    }
    else if (!LoadedAds.Any())
    {
        <div class="alert alert-info my-5">
            Нет доступных предложений.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4 text-center">Рекомендуемые товары</h2>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var ad in LoadedAds)
            {
                <ProductCard Product="@ad.Product"
                             Price="@ad.Product?.Price.ToString("C")"
                             ShowDetails="false"/>
            }
        </div>
    }
</div>

@code {
    private List<Advertisement>? LoadedAds = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadAdvertisements();
    }

    private async Task LoadAdvertisements()
    {
        try
        {
            LoadedAds = await DbContext.Ads
                .Take(4)
                .Include(a => a.Product)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ads: {ex.Message}");
            LoadedAds = new List<Advertisement>();
        }
        finally
        {
            StateHasChanged();
        }
    }
}
