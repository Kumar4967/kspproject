@page "/orders"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ksoproject.Models
@inject IOrderService OrderService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Мои заказы</PageTitle>

<div class="container mt-4">
    <h2>Мои заказы</h2>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка заказов...</p>
        </div>
    }
    else if (orders == null || !orders.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> У вас пока нет заказов.
            <a href="/shop" class="alert-link">Перейти к покупкам</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in orders)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>Заказ #@order.Id</strong>
                                <span class="badge bg-@(GetStatusColor(order.Status))">@GetStatusText(order.Status)</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-6">
                                    <small class="text-muted">Дата заказа</small>
                                    <p class="mb-0">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Сумма</small>
                                    <p class="mb-0 fw-bold text-primary">@order.TotalAmount.ToString("C")</p>
                                </div>
                            </div>

                            <div class="mb-2">
                                <small class="text-muted">Адрес доставки</small>
                                <p class="mb-0">@order.ShippingAddress</p>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted">Способ оплаты</small>
                                <p class="mb-0">@order.PaymentMethod</p>
                            </div>

                            <div class="btn-group w-100">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => ToggleDetails(order.Id)">
                                    @(expandedOrderId == order.Id ? "Скрыть товары" : "Показать товары")
                                </button>

                                @if (order.Status == "Pending")
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => CancelOrder(order.Id)">
                                        Отменить заказ
                                    </button>
                                }
                            </div>

                            @if (expandedOrderId == order.Id)
                            {
                                <div class="mt-3">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Товар</th>
                                                    <th>Кол-во</th>
                                                    <th>Цена</th>
                                                    <th>Сумма</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr>
                                                        <td>@item.ProductName</td>
                                                        <td>@item.Quantity</td>
                                                        <td>@item.Price.ToString("C")</td>
                                                        <td>@((item.Quantity * item.Price).ToString("C"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-light">
                                                <tr>
                                                    <td colspan="3" class="text-end fw-bold">Итого:</td>
                                                    <td class="fw-bold">@order.TotalAmount.ToString("C")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-3px);
    }
    .badge {
        font-size: 0.8em;
        padding: 5px 10px;
    }
</style>

@code {
    private List<Order>? orders;
    private bool isLoading = true;
    private int expandedOrderId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Get current user ID from auth state
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                orders = await OrderService.GetUserOrdersAsync(userId);
            }
            else
            {
                orders = new List<Order>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading orders: {ex.Message}");
            orders = new List<Order>();

            // Show error notification
            await ShowNotification("Ошибка при загрузке заказов", "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleDetails(int orderId)
    {
        expandedOrderId = expandedOrderId == orderId ? 0 : orderId;
    }

    private async Task CancelOrder(int orderId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Вы уверены, что хотите отменить этот заказ?"))
        {
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                if (!string.IsNullOrEmpty(userId))
                {
                    var success = await OrderService.CancelOrderAsync(orderId, userId);
                    if (success)
                    {
                        await ShowNotification("Заказ успешно отменен", "success");
                        await LoadOrders(); // Reload orders
                    }
                    else
                    {
                        await ShowNotification("Не удалось отменить заказ", "error");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cancelling order: {ex.Message}");
                await ShowNotification("Ошибка при отмене заказа", "error");
            }
        }
    }

    private string GetStatusColor(string status) => status switch
    {
        "Pending" => "warning",
        "Processing" => "info",
        "Shipped" => "primary",
        "Delivered" => "success",
        "Cancelled" => "danger",
        _ => "secondary"
    };

    private string GetStatusText(string status) => status switch
    {
        "Pending" => "Ожидает обработки",
        "Processing" => "В обработке",
        "Shipped" => "Отправлен",
        "Delivered" => "Доставлен",
        "Cancelled" => "Отменен",
        _ => status
    };

    private async Task ShowNotification(string message, string type)
    {
        await JS.InvokeVoidAsync("showNotification", message, type);
    }
}
