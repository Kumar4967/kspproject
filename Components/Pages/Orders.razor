@page "/orders"
@attribute [Authorize]
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ksoproject.Models
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Мои заказы</PageTitle>

<h2>Мои заказы</h2>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (orders == null || !orders.Any())
{
    <div class="alert alert-info">
        У вас пока нет заказов. <a href="/shop">Перейти к покупкам</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var order in orders)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <strong>Заказ #@order.Id</strong>
                        <span class="badge bg-@(GetStatusColor(order.Status)) float-end">@order.Status</span>
                    </div>
                    <div class="card-body">
                        <p><strong>Дата:</strong> @order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                        <p><strong>Сумма:</strong> @order.TotalAmount.ToString("C")</p>
                        <p><strong>Адрес доставки:</strong> @order.ShippingAddress</p>
                        <p><strong>Способ оплаты:</strong> @order.PaymentMethod</p>

                        <button class="btn btn-primary btn-sm" @onclick="() => ToggleDetails(order.Id)">
                            @(expandedOrderId == order.Id ? "Скрыть товары" : "Показать товары")
                        </button>

                        @if (order.Status == "Pending")
                        {
                            <button class="btn btn-danger btn-sm ms-2" @onclick="() => CancelOrder(order.Id)">
                                Отменить заказ
                            </button>
                        }

                        @if (expandedOrderId == order.Id)
                        {
                            <table class="table table-sm mt-3">
                                <thead>
                                    <tr>
                                        <th>Товар</th>
                                        <th>Кол-во</th>
                                        <th>Цена</th>
                                        <th>Сумма</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Price.ToString("C")</td>
                                            <td>@((item.Quantity * item.Price).ToString("C"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Order>? orders;
    private bool isLoading = true;
    private int expandedOrderId = 0;
    private HttpClient _httpClient = default!;

    protected override void OnInitialized()
    {
        _httpClient = HttpClientFactory.CreateClient();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try
        {
            isLoading = true;
            orders = await _httpClient.GetFromJsonAsync<List<Order>>("api/order/my-orders");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading orders: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleDetails(int orderId)
    {
        expandedOrderId = expandedOrderId == orderId ? 0 : orderId;
    }

    private async Task CancelOrder(int orderId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Вы уверены, что хотите отменить этот заказ?"))
        {
            var response = await _httpClient.PostAsync($"api/order/{orderId}/cancel", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadOrders();
            }
        }
    }

    private string GetStatusColor(string status) => status switch
    {
        "Pending" => "warning",
        "Processing" => "info",
        "Shipped" => "primary",
        "Delivered" => "success",
        "Cancelled" => "danger",
        _ => "secondary"
    };
}
