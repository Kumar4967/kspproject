@page "/login"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using BCrypt.Net
@inject IDbContextFactory<AppDbContext> DbFactory

@if (register is not null)
{
<PageTitle>Регистрация</PageTitle>
}
else
{
<PageTitle>Вход</PageTitle>
}

<div class="form-signin w-100 m-auto">
  <form>
    <h1 class="h3 mb-3 fw-normal">Пожалуйста, @(register != null ? "зарегистрируйтесь" : "войдите")
    </h1>
    <div class="form-floating">
      <input type="email" class="form-control" id="floatingInput" placeholder="name@example.com" @bind="LoginValue">
        <label for="floatingInput">Логин
        </label>
    </div>
    <div class="form-floating">
      <input type="password" class="form-control" id="floatingPassword" placeholder="Password" @bind="Password">
        <label for="floatingPassword">Пароль
        </label>
    </div>
    <div class="form-check text-start my-3">
      <input class="form-check-input" type="checkbox" value="remember-me" id="checkDefault">
        <label class="form-check-label" for="checkDefault">
          Запомнить вход
        </label>
    </div>
    <button @onclick="SendAccount" class="btn btn-primary w-100 py-2" type="submit">@(register != null ? "Создать аккаунт" : "Войти")</button>
  </form>
</div>

@code
{
    [SupplyParameterFromQuery]
    [Parameter]
    public string? register { get; set; }

    public string LoginValue = "";
    public string Password = "";

    private async void SendAccount()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        if (register != null)
        {
            if (await context.Users.AnyAsync(u => u.Username.ToLower() == LoginValue.ToLower()))
            {
                return;
            }
            string passwordHash = BCrypt.HashPassword(Password);
            var newUser = new User
            {
                Username = LoginValue,
                PasswordHash = passwordHash,
            };
            context.Users.Add(newUser);
            await context.SaveChangesAsync();
            return;
        }
        else
        {
            var user = await context.Users.FirstOrDefaultAsync(u => u.Username == LoginValue);
            if (user == null)
            {
                return;
            }
            bool isValid = BCrypt.Verify(Password, user.PasswordHash);
            if (!isValid)
            {
                // add login code here.
            }
        }
    }
}
