@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ICartService CartService

<div class="page container">
    <header class="p-3 text-bg-dark mb-3">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none">
                    Магазин КСП
                </a>
                <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <li><a href="/" class="nav-link px-2 text-secondary">Главная</a></li>
                    <li><a href="/shop" class="nav-link px-2 text-white">Товары</a></li>
                    <li><a href="/about" class="nav-link px-2 text-white">О нас</a></li>
                </ul>
                <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
                    <input type="search" class="form-control form-control-dark text-bg-dark" placeholder="Поиск..." aria-label="Поиск">
                </form>

                @if (isLoading)
                {
                    <div class="text-end">
                        <div class="spinner-border spinner-border-sm text-light" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (isAuthenticated)
                {
                    <div class="dropdown text-end">
                        <a href="#" class="d-block link-light text-decoration-none" @onclick="ToggleDropdown" @onclick:preventDefault="true">
                            <i class="bi bi-person-circle"></i> @userName
                        </a>
                        @if (showDropdown)
                        {
                            <ul class="dropdown-menu show" style="position: absolute; right: 0; display: block; background-color: #212529; border: 1px solid #4a4a4a;">
                                <li><a class="dropdown-item" href="/profile">Профиль</a></li>
                                <li><a class="dropdown-item" href="/orders">Мои заказы</a></li>
                                <li><a class="dropdown-item" href="/cart">Моя корзина</a></li>
                                @if (isAdmin)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/admin">Админ панель</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/logout">Выйти</a></li>
                            </ul>
                        }
                    </div>
                }
                else
                {
                    <div class="text-end">
                        <button id="loginbtn" @onclick="OpenLoginPage" type="button" class="btn btn-outline-light me-2">Войти</button>
                        <button id="registerbtn" @onclick="OpenRegisterPage" type="button" class="btn btn-warning">Зарегистрироваться</button>
                    </div>
                }
            </div>
        </div>
    </header>

    <main class="w-100 m-auto">
        @Body
    </main>

    <footer class="container pt-4 my-md-5 pt-md-5 border-top">
        <p>© 2026 Жуков. ·
            <a href="/about">Пользовательское соглашение</a> ·
            <a href="/about">Правила</a>
        </p>
    </footer>
</div>

@code {
    private bool isAuthenticated = false;
    private string userName = string.Empty;
    private bool isAdmin = false;
    private bool isLoading = true;
    private bool showDropdown = false;
    private DotNetObjectReference<MainLayout>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            isAuthenticated = user.Identity?.IsAuthenticated ?? false;

            if (isAuthenticated)
            {
                userName = user.Identity?.Name ?? user.FindFirst("email")?.Value ?? "Пользователь";
                isAdmin = user.IsInRole("Admin");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking auth: {ex.Message}");
            isAuthenticated = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isAuthenticated)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupClickOutsideHandler", dotNetHelper);
        }
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
        StateHasChanged();
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        if (showDropdown)
        {
            showDropdown = false;
            StateHasChanged();
        }
    }

    private void OpenRegisterPage()
    {
        Navigation.NavigateTo("/login?register=true", true);
    }

    private void OpenLoginPage()
    {
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }
}
