@inherits LayoutComponentBase

<div class="page container">
    <header class="p-3 text-bg-dark mb-3">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none">
                    Магазин КСП
                </a>
                <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <li><a href="/" class="nav-link px-2 text-secondary">Главная</a></li>
                    <li><a href="/shop" class="nav-link px-2 text-white">Товары</a></li>
                    <li><a href="/about" class="nav-link px-2 text-white">О нас</a></li>
                </ul>
                <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search"> <input type="search" class="form-control form-control-dark text-bg-dark" placeholder="Поиск..." aria-label="Поиск"> </form>
                <div class="text-end"> <button id="loginbtn" type="button" class="btn btn-outline-light me-2">Войти</button> <button id="registerbtn" type="button" class="btn btn-warning">Зарегистрироваться</button> </div>
            </div>
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="container pt-4 my-md-5 pt-md-5 border-top">
        <p class="float-end">
            <a href="#">Наверх</a>
        </p>
        <p>© 2026 Жуков. ·
            <a href="/about">Пользовательское соглашение
            </a> ·
            <a href="/about">Правила
            </a>
        </p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Возникла непредвиденная ошибка.
    <a href="." class="reload">Перезапустить</a>
    <span class="dismiss">Закрыть</span>
</div>
